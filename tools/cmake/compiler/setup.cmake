# * Set default options for all compilers. These can be overriden by the user.
if(CMAKE_CXX_COMPILER_ID STREQUAL "MSVC")
  include(${CMAKE_CURRENT_LIST_DIR}/cl.cmake)
elseif(CMAKE_CXX_COMPILER_ID STREQUAL "Clang" AND CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL "GNU")
  include(${CMAKE_CURRENT_LIST_DIR}/clang.cmake)
elseif(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
  include(${CMAKE_CURRENT_LIST_DIR}/gcc.cmake)
endif()

list(APPEND TRIBO_CXX_FLAGS $<IF:$<CONFIG:Debug>,${TRIBO_CXX_FLAGS_DEBUG},${TRIBO_CXX_FLAGS_RELEASE}>)
list(APPEND TRIBO_LINKER_FLAGS $<IF:$<CONFIG:Debug>,${TRIBO_LINKER_FLAGS_DEBUG},${TRIBO_LINKER_FLAGS_RELEASE}>)
