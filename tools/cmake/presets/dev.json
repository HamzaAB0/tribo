{
  "version": 10,
  "$schema": "https://cmake.org/cmake/help/latest/_downloads/3e2d73bff478d88a7de0de736ba5e361/schema.json",
  "include": [
    "common.json"
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "dev",
      "configuration": "Release",
      "targets": "install"
    },
    {
      "name": "debug",
      "configurePreset": "dev",
      "configuration": "Debug"
    }
  ],
  "workflowPresets": [
    {
      "name": "release",
      "steps": [
        {
          "type": "configure",
          "name": "dev"
        },
        {
          "type": "build",
          "name": "release"
        }
      ]
    },
    {
      "name": "debug",
      "steps": [
        {
          "type": "configure",
          "name": "dev"
        },
        {
          "type": "build",
          "name": "debug"
        }
      ]
    },
    {
      "name": "all",
      "steps": [
        {
          "type": "configure",
          "name": "dev"
        },
        {
          "type": "build",
          "name": "debug"
        },
        {
          "type": "build",
          "name": "release"
        }
      ]
    }
  ]
}
