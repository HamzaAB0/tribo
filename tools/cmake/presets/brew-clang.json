{
  "version": 10,
  "$schema": "https://cmake.org/cmake/help/latest/_downloads/3e2d73bff478d88a7de0de736ba5e361/schema.json",
  "include": [
    "common.json"
  ],
  "configurePresets": [
    {
      "name": "brew-clang",
      "inherits": "dev",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "/opt/homebrew/opt/llvm/bin/clang++",
        "CMAKE_CXX_STDLIB_MODULES_JSON": "/opt/homebrew/opt/llvm/lib/c++/libc++.modules.json"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "brew-clang-release",
      "configurePreset": "brew-clang",
      "configuration": "Release",
      "targets": "install"
    },
    {
      "name": "brew-clang-debug",
      "configurePreset": "brew-clang",
      "configuration": "Debug"
    }
  ],
  "workflowPresets": [
    {
      "name": "brew-clang-release",
      "steps": [
        {
          "type": "configure",
          "name": "brew-clang"
        },
        {
          "type": "build",
          "name": "brew-clang-release"
        }
      ]
    },
    {
      "name": "brew-clang-debug",
      "steps": [
        {
          "type": "configure",
          "name": "brew-clang"
        },
        {
          "type": "build",
          "name": "brew-clang-debug"
        }
      ]
    },
    {
      "name": "brew-clang-all",
      "steps": [
        {
          "type": "configure",
          "name": "brew-clang"
        },
        {
          "type": "build",
          "name": "brew-clang-debug"
        },
        {
          "type": "build",
          "name": "brew-clang-release"
        }
      ]
    }
  ]
}
